  "safety": {
    "rules": [
      {
        "es": "Cocinar pollo hasta 74 °C en el centro. Sin excepción.",
        "en": "Cook chicken to 74 °C in the centre. No exceptions."
      },
      {
        "es": "Frío por debajo de 5 °C. Caliente por encima de 60 °C. Nada se queda entre esas dos.",
        "en": "Cold below 5 °C. Hot above 60 °C. Nothing sits between the two."
      },
      {
        "es": "Enfriar el arroz y el pollo cocido a menos de 5 °C dentro de 2 horas. En bandeja baja, no en olla.",
        "en": "Chill cooked rice and chicken below 5 °C within 2 hours. In a shallow tray, not the pot."
      },
      {
        "es": "Nada preparado se queda a temperatura ambiente más de 2 horas. Con este calor, botarlo.",
        "en": "Nothing prepped sits at room temperature for more than 2 hours. In this heat, bin it."
      },
      {
        "es": "Rotular todo con la fecha y hora de preparación. Sin etiqueta, no se usa.",
        "en": "Label everything with prep date and time. No label, no use."
      }
    ],
    "note": {
      "es": "El arroz cocido a temperatura ambiente es la causa más común de intoxicación en cocinas como esta. Refrigerarlo apenas se enfría.",
      "en": "Cooked rice left at room temperature is the most common cause of food poisoning in kitchens like this one. Refrigerate as soon as it cools."
    }
  },
