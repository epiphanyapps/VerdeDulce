    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.15.3",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "eslint": "9.39.1",
